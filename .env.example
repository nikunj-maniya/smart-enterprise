# ── API ──────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
# Set only when actually deployed behind a reverse proxy/load balancer — the hop count Express
# should trust for X-Forwarded-For (e.g. 1). Leave unset for local dev.
# TRUST_PROXY=1

# ── Database (PostgreSQL) ────────────────────────────
# Host port 5544 (container 5432) — avoids clashing with other local Postgres instances
DATABASE_URL=postgresql://smart:smart@localhost:5544/smart_enterprise?schema=public

# ── Redis ────────────────────────────────────────────
# Host port 6399 (container 6379)
REDIS_URL=redis://localhost:6399

# ── Auth ─────────────────────────────────────────────
# Local-dev-only value below (checked into git, same posture as the DB/MinIO creds in this file) —
# generate your own with: openssl rand -base64 32. Never reuse this outside local dev.
# Refresh tokens are opaque, server-side-tracked (RefreshTokenSession) — no secret needed for them.
JWT_ACCESS_SECRET=0qrfyQ9iL9EylDIipIVpEPHWSYiAs10ljlnjWmAzE/s=

# ── Bootstrap System Admin (seeded once) ─────────────
SYSTEM_ADMIN_EMAIL=systemadmin@smartenterprise.com
SYSTEM_ADMIN_PASSWORD=Smart@123

# ── Slack integration (per-tenant credentials encrypted at rest) ──
# Generate with: openssl rand -base64 32
SLACK_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ── Object storage (MinIO — visitor signatures) ──
# Host port 9500 (console 9501, container 9000/9090)
MINIO_ENDPOINT=localhost
MINIO_PORT=9500
MINIO_ACCESS_KEY=smart
MINIO_SECRET_KEY=smartminio
MINIO_BUCKET=smart-enterprise

# ── Web ──────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Comma-separated allowlist for the API's CORS origin check — defaults to WEB_URL if unset.
CORS_ORIGIN=http://localhost:5173
