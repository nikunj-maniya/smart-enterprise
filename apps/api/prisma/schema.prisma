// smartEnterprise data model — PRD §12.
// Every tenant-scoped table carries a non-null tenantId (isolation at the data layer).
// The platform System Admin is the ONLY user with tenantId = null (not tenant-scoped).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  Pending
  Active
  Suspended
  Rejected
}

enum UserStatus {
  Pending
  Active
  Inactive
  Suspended
}

enum RegistrationStatus {
  Pending
  Accepted
  Rejected
}

enum FormRenderer {
  core
  generic
}

enum FormStatus {
  draft
  published
  archived
}

// ── Tenancy ────────────────────────────────────────────────
model Tenant {
  id        String       @id @default(cuid())
  name      String
  industry  String?
  size      String?
  website   String?
  branding  Json?
  settings  Json?
  status    TenantStatus @default(Pending)
  createdAt DateTime     @default(now())

  users       User[]
  departments Department[]
  roles       Role[]
  projects    Project[]
  leaveTypes  LeaveType[]
  forms       FormDefinition[]
  requests    Request[]
  notifications Notification[]
  auditLogs   AuditLog[]
  registration EnterpriseRegistration?
  registrationLink RegistrationLink?
  escalationRules EscalationRule[]
  itemCatalog ItemCatalog[]
  slackConfig SlackConfig?
  holidays    Holiday[]
  smartSearchConversations SmartSearchConversation[]
  smartSearchMemories SmartSearchMemory[]
}

// Shareable employee self-registration link — at most one active link per tenant.
// Token is stored raw (not hashed) so the admin can re-display/copy the URL; it only
// grants Employee-level self-registration into this tenant and is expiring + revocable.
model RegistrationLink {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  token     String   @unique
  expiresAt DateTime
  createdBy String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model EnterpriseRegistration {
  id           String             @id @default(cuid())
  tenantId     String             @unique
  userId       String             @unique
  companyName  String
  contactName  String
  contactEmail String
  size         String?
  industry     String?
  website      String?
  status       RegistrationStatus @default(Pending)
  reviewedBy   String?
  reviewNote   String?
  createdAt    DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

// ── Identity ───────────────────────────────────────────────
model User {
  id                 String     @id @default(cuid())
  tenantId           String? // null = platform System Admin
  name               String
  email              String     @unique
  passwordHash       String
  status             UserStatus @default(Pending)
  mustChangePassword Boolean    @default(false) // drives forced password change (resetPassword flag)
  isSystemAdmin      Boolean    @default(false)
  // Self-service profile fields (PRD §5A / Profile) — user-editable, optional.
  phone              String?
  jobTitle           String?
  location           String?
  // Per-user, per-channel notification preferences (reporting-and-polish): a sparse map of
  // `{ [notificationType]: { inApp?: boolean, slack?: boolean } }` — an absent type/channel
  // defaults to enabled; mandatory types (NOTIFICATION_TYPE_CATALOG) ignore this entirely.
  notificationPreferences Json?
  createdAt          DateTime   @default(now())

  tenant            Tenant?              @relation(fields: [tenantId], references: [id])
  roles             UserRole[]
  departments       UserDepartment[]
  projectMembers    ProjectMember[]
  leaveBalances     LeaveBalance[]
  requests          Request[]
  registration      EnterpriseRegistration?
  resetTokens       PasswordResetToken[]
  departmentHeads   DepartmentHead[]
  refreshTokenSessions RefreshTokenSession[]
  smartSearchConversations SmartSearchConversation[]
  smartSearchMemories SmartSearchMemory[]

  @@index([tenantId])
}

// Self-service password reset. tokenHash stores a SHA-256 hash of the token
// sent to the user — the raw token is never persisted.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Server-side, revocable refresh-token session (security audit finding #5): the refresh token
// itself is an opaque random string, never a self-contained JWT — tokenHash stores its SHA-256
// hash so revocation (logout, password change/reset) actually takes effect immediately instead
// of a stolen token staying valid for its whole TTL regardless.
model RefreshTokenSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  permissions String[]
  isSystem    Boolean  @default(false) // seeded System roles: renamable, permissions fixed, undeletable
  archived    Boolean  @default(false) // archived roles are hidden from assignment pickers, kept in history

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  users  UserRole[]
  escalationTargetOf EscalationRule[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Department {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  archived Boolean @default(false) // archived departments are hidden from pickers, kept in history

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  heads  DepartmentHead[]
  users  UserDepartment[]

  @@index([tenantId])
}

// A department can have multiple heads (leads) — join table between Department and User.
model DepartmentHead {
  departmentId String
  userId       String

  department Department @relation(fields: [departmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@id([departmentId, userId])
  @@index([userId])
}

model UserDepartment {
  userId       String
  departmentId String

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([userId, departmentId])
}

model Project {
  id       String @id @default(cuid())
  tenantId String
  name     String
  status   String @default("active") // active | archived

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  members ProjectMember[]

  @@index([tenantId])
}

model ProjectMember {
  projectId     String
  userId        String
  roleInProject String // PM | TL | member

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
}

// ── Leave ──────────────────────────────────────────────────
model LeaveType {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  quota       Float   @default(0)
  accrualRule Json?
  isPaid      Boolean @default(true)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  balances LeaveBalance[]

  @@index([tenantId])
}

model LeaveBalance {
  id          String @id @default(cuid())
  userId      String
  leaveTypeId String
  balance     Float  @default(0)
  period      String

  user      User      @relation(fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, period])
}

// Company holidays (attendance-report): weekday holidays reduce the working-day baseline the
// attendance report computes payable days from. `date` is a calendar day stored at UTC midnight
// (same convention as Request.startDate); the unique also serves tenant-scoped lookups.
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
}

// ── Form engine (metadata) ─────────────────────────────────
model FormDefinition {
  id        String       @id @default(cuid())
  tenantId  String
  key       String
  title     String
  version   Int          @default(1)
  renderer  FormRenderer @default(core)
  status    FormStatus   @default(draft)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  sections         FormSection[]
  approvalWorkflow ApprovalWorkflow?
  statusModel      StatusModel?
  requests         Request[]

  @@unique([tenantId, key, version])
  @@index([tenantId])
}

model FormSection {
  id               String  @id @default(cuid())
  formDefinitionId String
  order            Int
  title            String
  visibilityRule   Json?

  form   FormDefinition @relation(fields: [formDefinitionId], references: [id])
  fields FormField[]
}

model FormField {
  id             String  @id @default(cuid())
  sectionId      String
  key            String
  label          String
  type           String
  order          Int     @default(0)
  required       Boolean @default(false)
  options        Json?
  validation     Json?
  visibilityRule Json?

  section FormSection @relation(fields: [sectionId], references: [id])
}

model ApprovalWorkflow {
  id               String @id @default(cuid())
  formDefinitionId String @unique
  mode             String @default("parallel")
  stageRules       Json?

  form FormDefinition @relation(fields: [formDefinitionId], references: [id])
}

model StatusModel {
  id               String @id @default(cuid())
  formDefinitionId String @unique
  states           Json
  transitions      Json

  form FormDefinition @relation(fields: [formDefinitionId], references: [id])
}

// ── Requests ───────────────────────────────────────────────
// Hybrid storage: canonical `payload` JSONB + promoted typed columns for
// cross-cutting queries (absence calendar, leave balance, dashboards).
model Request {
  id               String   @id @default(cuid())
  tenantId         String
  formDefinitionId String
  formVersion      Int
  requesterId      String
  status           String
  payload          Json

  // Promoted typed columns
  startDate     DateTime?
  endDate       DateTime?
  totalDays     Float?
  halfDayCount  Float?
  leaveTypeId   String?
  departmentId  String?
  projectId     String?

  // Leave/WFH flags computed server-side at submission (leave-wfh-requests) — never
  // client-supplied, never gate approval; surfaced to approvers/HR as badges.
  overBalance             Boolean?
  specialConditionFlagged Boolean?

  // IT fulfilment (it-requests): claim-based assignment — first IT Admin to claim owns it;
  // a promoted column since the Fulfilment Queue queries/filters on it constantly.
  itAssigneeId String?

  createdAt DateTime @default(now())

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  form          FormDefinition         @relation(fields: [formDefinitionId], references: [id])
  requester     User                   @relation(fields: [requesterId], references: [id])
  approvers     RequestApprover[]
  statusHistory RequestStatusHistory[]
  visitor       Visitor?

  @@index([tenantId])
  @@index([startDate, endDate])
  @@index([requesterId])
}

// Per-tenant software/hardware item master data (it-requests) — pickers on the IT form resolve
// their options from here at read/submit time, never from the form's own metadata, so an admin
// edit applies instantly without a republish. Archived (not deleted) once referenced by a request.
model ItemCatalog {
  id       String  @id @default(cuid())
  tenantId String
  type     String // 'software' | 'hardware'
  name     String
  archived Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type, name])
  @@index([tenantId, type])
}

model RequestApprover {
  id          String    @id @default(cuid())
  requestId   String
  approverId  String
  roleContext String
  decision    String? // pending | approved | rejected
  decidedAt   DateTime?
  comment     String?

  // Set when the sweep reassigns this row per the escalation matrix (design.md: reassign
  // the existing row rather than add a second one, so "all must approve" arithmetic stays trivial).
  escalatedFromId String? // the approverId this row held before reassignment
  escalationCause String? // 'on_leave' | 'inactive' | 'timeout'
  escalatedAt     DateTime?

  request Request @relation(fields: [requestId], references: [id])

  @@index([approverId, decision])
}

// Tenant-scoped escalation matrix (escalation-workflow spec): maps a `RequestApprover.roleContext`
// value to the Role that stage escalates to, both for self-approval prevention at submission and
// the sweep's stalled/unavailable-approver escalation. `fromContext` matches `roleContext` as
// produced by `resolveApprovers`/`roleContextFor` — a `Role.key` when the field is role-restricted,
// otherwise the field's own key (e.g. an unrestricted Tech Lead picker's context is `tech_lead`).
model EscalationRule {
  id                String @id @default(cuid())
  tenantId          String
  fromContext       String
  toRoleId          String
  actionWindowHours Int    @default(48)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  toRole Role   @relation(fields: [toRoleId], references: [id])

  @@unique([tenantId, fromContext])
  @@index([tenantId])
}

model RequestStatusHistory {
  id        String   @id @default(cuid())
  requestId String
  fromState String?
  toState   String
  actorId   String?
  note      String?
  at        DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id])
}

model Visitor {
  id          String    @id @default(cuid())
  requestId   String    @unique
  checkInAt   DateTime?
  checkOutAt  DateTime?
  consent     Boolean   @default(false)
  // reporting-and-polish: signature captured at check-in, stored in MinIO — this column holds
  // only the object key (never a URL); retrieval is always through a fresh, short-lived signed
  // GET URL (lib/object-storage.ts), never a public path.
  signatureObjectKey String?

  request Request @relation(fields: [requestId], references: [id])
}

// ── Platform ───────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId, read])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String?
  actorId  String?
  entity   String
  entityId String
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Singleton table — exactly one row (id = "singleton"), application-managed.
model PlatformSettings {
  id                              String   @id @default("singleton")
  forcePasswordChangeOnFirstLogin Boolean  @default(true)
  allowPublicRegistration         Boolean  @default(true)
  notifyOnNewRegistration         Boolean  @default(true)
  updatedAt                       DateTime @updatedAt
  updatedBy                       String?
}

// ── Slack Integration (slack-integration, tenant-scoped, PRD §11) ──
// `botTokenEncrypted`/`signingSecretEncrypted` are AES-256-GCM ciphertext (see lib/crypto.ts) —
// never plaintext, never returned by any API. `slackTeamId` (from `auth.test` on connect) lets
// the interaction webhook route an unauthenticated payload to the right tenant's signing secret
// before verifying it.
model SlackConfig {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  status                String   @default("disconnected") // disconnected | connected | error
  workspaceName         String?
  slackTeamId           String?
  defaultChannel        String?
  botTokenEncrypted     String?
  signingSecretEncrypted String?
  lastErrorMessage      String?

  notifyApproversOnNewRequest   Boolean @default(true)
  notifyRequesterOnDecision     Boolean @default(true)
  notifyRequesterOnStatusChange Boolean @default(true)

  digestEnabled      Boolean @default(false)
  digestChannel      String?
  digestTime         String? // "HH:mm", evaluated in Asia/Kolkata
  lastDigestSentDate String? // "YYYY-MM-DD" — guards against sending twice in one day

  reminderEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([slackTeamId])
}

// ── Smart Search: persistent chat history + long-term memory (smart-search, tenant+user-scoped) ──
// Threads and memories are private to the user who owns them — never visible to other users, even
// within the same tenant. Every query against these two models must filter on both tenantId and
// userId, consistent with the existing tool permission checks in smart-search.tools.ts.
model SmartSearchConversation {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  title    String? // derived from the first user message, shown in the history list

  // Context management: once a thread grows long, older turns are folded into `summary` and
  // excluded from the raw prompt window sent to the model — messages with createdAt at or before
  // `summarizedUntil` are already represented by `summary`, so the sliding window only needs to
  // cover what comes after it. Keeps the local 7b model's limited context bounded without an
  // ever-growing history.
  summary         String?
  summarizedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  user     User                 @relation(fields: [userId], references: [id])
  messages SmartSearchMessage[]

  @@index([tenantId, userId, updatedAt])
}

model SmartSearchMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // 'user' | 'assistant' — mirrors SmartSearchChatMessage.role (@se/shared)
  content        String
  createdAt      DateTime @default(now())

  conversation SmartSearchConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

// Long-term memory: facts/preferences the assistant has decided are worth remembering about a
// user, surfaced across separate conversations (not just explicit "remember X" commands). Users
// can view/edit/delete these directly (privacy requirement), so each row is a single, standalone
// fact rather than an append-only log.
model SmartSearchMemory {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  content   String // one remembered fact/preference, e.g. "Prefers async standups"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
}
